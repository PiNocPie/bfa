    "deploy:base-sepolia": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "solc": "0.8.30",
    "viem": "2.57.15"
  }
}
