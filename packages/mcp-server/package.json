  "description": "Nen MCP server: AI agents discover, quote and pay for APIs per call over x402, signed by their NEAR account via Chain Signatures. No private key in config.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nen-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
