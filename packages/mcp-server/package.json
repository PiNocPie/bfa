    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nen-near/core": "workspace:*",
    "@nen-near/x402-client": "workspace:*",
    "ajv": "8.17.1",
    "viem": "2.57.15",
    "zod": "4.1.12"
  }
}
