{
  "name": "@bfa/x402-client",
  "version": "0.1.0",
  "description": "Pay x402 V2 endpoints from an agent wallet. Pluggable signer: local key for tests, NEAR Chain Signatures in production.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "chainsig:testnet": "NODE_USE_ENV_PROXY=1 node scripts/chainsig-testnet.mjs",
    "e2e:testnet": "NODE_USE_ENV_PROXY=1 node scripts/e2e-testnet.mjs"
  },
  "dependencies": {
    "@bfa/core": "workspace:*",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/fetch": "2.29.0",
    "ajv": "8.17.1",
    "chainsig.js": "1.1.16",
    "viem": "2.57.15",
    "near-api-js": "7.4.0"
  }
}
