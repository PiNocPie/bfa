{
  "$schema": "../../schema/listing.schema.json",
  "manifest_version": 1,
  "id": "bfa/web-scrape",
  "provider": {
    "name": "BFA",
    "url": "https://github.com/PiNocPie/nen",
    "contact": "https://github.com/PiNocPie/nen/issues"
  },
  "name": "Web page to markdown",
  "description": "Fetch one public web page and return clean markdown plus the title, ready for an agent to read. Coming soon: not live yet, so it can't be bought. The price is the planned price.",
  "categories": [
    "web"
  ],
  "tags": [
    "scrape",
    "markdown",
    "crawl",
    "coming-soon"
  ],
  "endpoint": {
    "url": "https://bfagateway-production.up.railway.app/soon/web-scrape",
    "method": "POST",
    "input_schema": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "output_schema": {
      "type": "object"
    },
    "example_input": {
      "url": "https://near.org"
    }
  },
  "pricing": {
    "model": "per_call",
    "amount_usd": "0.001",
    "charges_empty_results": false
  },
  "payment": {
    "protocol": "x402",
    "networks": [
      "eip155:84532"
    ],
    "payout": {
      "via": "direct"
    }
  },
  "data": {
    "sources": "Planned BFA endpoint. Upstream sources will be chosen per their terms before launch.",
    "license_statement": "Not live. BFA will only launch this on sources whose terms allow agents to use the data this way.",
    "terms_url": "https://github.com/PiNocPie/nen/blob/main/README.md"
  }
}
